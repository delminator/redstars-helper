{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Redstars Helper",
  "version": "0.2.6",
  "identifier": "fr.redlinks.redstars-helper",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Redstars Helper",
        "label": "main",
        "width": 540,
        "height": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:8080 http://localhost:9999 https://esm.sh https://github.com",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Redstars local helper",
    "longDescription": "Local agent that runs the Redstars demo helper (USB scale, Firefox prefs writer, demo HTTP server). Auto-updates from GitHub releases.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "bundled/helper.py",
      "bundled/index.html",
      "bundled/sw.js",
      "bundled/decoder.onnx",
      "bundled/encoder.onnx",
      "bundled/demo_data.json",
      "bundled/cert.pem",
      "bundled/key.pem"
    ],
    "linux": {
      "deb": {
        "depends": ["python3", "python3-pip"]
      },
      "rpm": {
        "depends": ["python3", "python3-pip"]
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/delminator/redstars-helper/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3MUNGQjI5OTY0ODNBOEIKUldTTE9raVdLZnNjWnpEOWNPZGE0VUZGUnlPWkpoNWx1L2xaWjU2K294YTE1MkZYaU50dnVNL2IK"
    }
  }
}
